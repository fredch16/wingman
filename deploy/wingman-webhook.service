[Unit]
Description=Wingman Instagram webhook-only listener
After=network-online.target
Wants=network-online.target

[Service]
User=fred
WorkingDirectory=/home/fred/wingman-hackathon
ExecStart=/home/fred/wingman-hackathon/.venv/bin/gunicorn --bind 127.0.0.1:5001 --workers 1 --threads 4 'wingman.instagram.webhook_server:webhook_only_app()'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
